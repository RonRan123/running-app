generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Activity {
  id           String          @id @default(cuid())
  name         String
  date         DateTime
  distance     Float
  duration     Int
  avgPace      Float?
  avgHeartRate Int?
  maxHeartRate Int?
  sport        String          @default("Run")
  coordinates  Json?
  source       String          @default("upload")
  externalId   String?         @unique
  createdAt    DateTime        @default(now())
  stream       ActivityStream?

  // Weather at run time (Open-Meteo historical archive). weatherFetchedAt is
  // stamped on every fetch *attempt* — success or definitive failure — so
  // backfill only ever queries runs where it is null.
  weatherTempC         Float?
  weatherDewPointC     Float?
  weatherApparentTempC Float?
  weatherFetchedAt     DateTime?
}

// Raw per-sample time-series for a run. Each Json column is a number[]
// aligned index-by-index with `time` (seconds from start).
model ActivityStream {
  id         String   @id @default(cuid())
  activityId String   @unique
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  time       Json
  heartrate  Json?
  velocity   Json? // m/s
  altitude   Json? // meters
  cadence    Json?
  distance   Json? // cumulative meters
  fetchedAt  DateTime @default(now())
}

// Single-row settings table (id is always 1)
model UserSettings {
  id  Int  @id @default(1)
  age Int?

  // Date window the demo account is allowed to see. Null = fall back to the
  // default window hardcoded in lib/activities.ts.
  demoFromDate DateTime?
  demoToDate   DateTime?
}

model RaceGoal {
  id        String   @id @default(cuid())
  name      String
  date      DateTime
  distance  Float // km
  goalTime  Int // seconds
  createdAt DateTime @default(now())
}

model LoginEvent {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  ipAddress String?
  userAgent String?
  country   String?
  region    String?
  city      String?
}
