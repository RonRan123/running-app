generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Activity {
  id           String          @id @default(cuid())
  name         String
  date         DateTime
  distance     Float
  duration     Int
  avgPace      Float?
  avgHeartRate Int?
  maxHeartRate Int?
  sport        String          @default("Run")
  coordinates  Json?
  source       String          @default("upload")
  externalId   String?         @unique
  createdAt    DateTime        @default(now())
  stream       ActivityStream?
  segmentEfforts SegmentEffort[]
}

// Raw per-sample time-series for a run. Each Json column is a number[]
// aligned index-by-index with `time` (seconds from start).
model ActivityStream {
  id         String   @id @default(cuid())
  activityId String   @unique
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  time       Json
  heartrate  Json?
  velocity   Json? // m/s
  altitude   Json? // meters
  cadence    Json?
  distance   Json? // cumulative meters
  fetchedAt  DateTime @default(now())
}

// Single-row settings table (id is always 1)
model UserSettings {
  id  Int  @id @default(1)
  age Int?
}

// A named start-to-finish stretch of road, defined from one run's GPS track.
// `polyline` is a {lat,lng}[] reference track used for display and length.
model Segment {
  id        String          @id @default(cuid())
  name      String
  polyline  Json
  startLat  Float
  startLng  Float
  endLat    Float
  endLng    Float
  distance  Float // km along the reference polyline
  createdAt DateTime        @default(now())
  efforts   SegmentEffort[]
}

// One run's pass through a segment (fastest pass if the run crossed it twice).
// startIdx/endIdx are sample indices into the activity's stream arrays.
model SegmentEffort {
  id         String   @id @default(cuid())
  segmentId  String
  segment    Segment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  startIdx   Int
  endIdx     Int
  elapsed    Int // seconds
  avgHr      Int?
  avgPace    Float? // min/km
  avgGap     Float? // min/km
  elevGain   Float? // meters
  createdAt  DateTime @default(now())

  @@unique([segmentId, activityId])
}

model RaceGoal {
  id        String   @id @default(cuid())
  name      String
  date      DateTime
  distance  Float // km
  goalTime  Int // seconds
  createdAt DateTime @default(now())
}
