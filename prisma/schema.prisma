generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Activity {
  id           String          @id @default(cuid())
  name         String
  date         DateTime
  distance     Float
  duration     Int
  avgPace      Float?
  avgHeartRate Int?
  maxHeartRate Int?
  sport        String          @default("Run")
  coordinates  Json?
  source       String          @default("upload")
  externalId   String?         @unique
  createdAt    DateTime        @default(now())
  stream       ActivityStream?
  efforts      SegmentEffort[]

  // Weather at run time (Open-Meteo historical archive). weatherFetchedAt is
  // stamped on every fetch *attempt* — success or definitive failure — so
  // backfill only ever queries runs where it is null.
  weatherTempC         Float?
  weatherDewPointC     Float?
  weatherApparentTempC Float?
  weatherFetchedAt     DateTime?
}

// Raw per-sample time-series for a run. Each Json column is a number[]
// aligned index-by-index with `time` (seconds from start).
model ActivityStream {
  id         String   @id @default(cuid())
  activityId String   @unique
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  time       Json
  heartrate  Json?
  velocity   Json? // m/s
  altitude   Json? // meters
  cadence    Json?
  distance   Json? // cumulative meters
  // Time-aligned GPS: (number | null)[] index-matched with `time`; null
  // entries are GPS dropouts. Activity.coordinates drops those samples, so
  // only these columns can time a segment effort.
  latitude   Json?
  longitude  Json?
  fetchedAt  DateTime @default(now())
}

// Single-row settings table (id is always 1)
model UserSettings {
  id  Int  @id @default(1)
  age Int?

  // Date window the demo account is allowed to see. Null = fall back to the
  // default window hardcoded in lib/activities.ts.
  demoFromDate DateTime?
  demoToDate   DateTime?
}

model RaceGoal {
  id        String   @id @default(cuid())
  name      String
  date      DateTime
  distance  Float // km
  goalTime  Int // seconds
  createdAt DateTime @default(now())
}

model LoginEvent {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  ipAddress String?
  userAgent String?
  country   String?
  region    String?
  city      String?
}

// A stretch run many times across different routes, found automatically by
// lib/segments/discover.ts (or pinned/renamed by the user).
model Segment {
  id        String          @id @default(cuid())
  name      String
  geometry  Json // {lat, lng}[] resampled every 10 m, in running direction
  lengthM   Float
  elevation Json? // meters, aligned with geometry; null until computed
  strength  Int // distinct runs with a full effort
  pinned    Boolean         @default(false)
  renamed   Boolean         @default(false) // name chosen by the user
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  efforts   SegmentEffort[]
}

// One pass through a segment. A run can have several (laps, repeats).
model SegmentEffort {
  id           String   @id @default(cuid())
  segmentId    String
  segment      Segment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  activityId   String
  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  startIndex   Int // stream sample indices bracketing the effort
  endIndex     Int
  startSec     Float // interpolated crossing times, seconds from run start
  endSec       Float
  elapsedSec   Float
  avgHeartRate Float?
  date         DateTime // copied from Activity for date-window filtering

  @@unique([segmentId, activityId, startIndex])
  @@index([activityId])
}
